    {
      "name": "Admin - list every event including suspended and past",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "// The admin site asks for every event, so the public filters must not",
              "// quietly hide the suspended and finished ones from staff.",
              "const body = pm.response.json();",
              "",
              "pm.test('returns the whole table, not just upcoming events', () => {",
              "    pm.expect(body.count).to.be.above(8);",
              "});",
              "",
              "pm.test('suspended or finished events are included', () => {",
              "    const hidden = body.events.filter(e => e.status === 'suspended' || e.is_past);",
              "    pm.expect(hidden.length).to.be.above(0);",
              "});",
              "",
              "pm.test('every event carries its booking count', () => {",
              "    body.events.forEach(e => pm.expect(e).to.have.property('registration_count'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/events?status=all&period=all",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "events"
          ],
          "query": [
            {
              "key": "status",
              "value": "all"
            },
            {
              "key": "period",
              "value": "all"
            }
          ]
        },
        "description": "What the admin list calls. Without status=all and period=all the API returns only upcoming active events, so staff would never see a suspended event they need to fix, or a finished one they need the record of."
      },
      "response": []
    },
