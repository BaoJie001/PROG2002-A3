    "name": "Giving Coast API - PROG2002 A3",
    "description": "Every endpoint of the Giving Coast API (PROG2002 Assessment 3).\n\nHow to use it:\n1. Import this file into Postman.\n2. Set the variable base_url to your own API root:\n   - local:      http://localhost:3000\n   - cPanel:     https://yourusername.scuweb.net\n3. Run the folder top to bottom, or open Runner and run the whole collection.\n\nEach request has a Test tab that checks the status code and the shape of the\nJSON, so a run turns the folder green or red instead of leaving you to read\nthe responses by eye.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "event_id",
      "value": "5"
    },
    {
      "key": "new_event_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health - is the API and database up",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('database is connected', () => pm.expect(body.database).to.eql('connected'));",
              "pm.test('counts are reported', () => {",
              "    pm.expect(body.counts).to.have.property('events');",
              "    pm.expect(body.counts.events).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Events - list upcoming (home page)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/events",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('count matches the array length', () => pm.expect(body.count).to.eql(body.events.length));",
              "pm.test('every event is active and not in the past', () => {",
              "    const today = new Date().toISOString().slice(0, 10);",
              "    body.events.forEach(e => {",
              "        pm.expect(e.status).to.eql('active');",
              "        pm.expect(e.event_date >= today).to.be.true;",
              "    });",
              "});",
              "pm.test('organiser and category are joined in', () => {",
              "    const e = body.events[0];",
              "    pm.expect(e).to.have.property('organisation');",
              "    pm.expect(e).to.have.property('category');",
              "});"
            ]
          }
        }
      ]
    },
