      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK even when no forecast exists', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('the page can tell whether to show the panel', () => {",
              "    pm.expect(body).to.have.property('available');",
              "});",
