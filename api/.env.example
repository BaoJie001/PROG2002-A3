# ---------------------------------------------------------------------------
# Copy this file to ".env" and edit the values. ".env" is never committed.
# On SCU cPanel these values are set in the Node.js App screen instead.
# ---------------------------------------------------------------------------

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_db

# Port the API listens on (cPanel assigns this automatically - do not hard-code)
PORT=3000

# Origin allowed to call the API. Use * while developing locally, and the
# exact cPanel URL (e.g. https://a3.example.scu.edu.au) once deployed.
ALLOWED_ORIGIN=*
